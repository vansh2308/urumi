# Copy to .env for local development. Never commit real credentials; in Kubernetes inject
# DB_URL and AUTH_TOKEN_PEPPER from a Secret and the rest from a ConfigMap.

APP_ENV=local                 # local | staging | production
LOG_LEVEL=INFO
LOG_FORMAT=console            # json in clusters

# --- HTTP server ------------------------------------------------------------------------------
GATEWAY_HOST=127.0.0.1        # 0.0.0.0 in a container
GATEWAY_PORT=8100
# GATEWAY_SHUTDOWN_GRACE_SECONDS=25
# GATEWAY_FORWARDED_ALLOW_IPS=127.0.0.1   # ingress / load balancer addresses
# GATEWAY_MAX_REQUEST_BODY_BYTES=1048576
# GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:5173
# GATEWAY_METRICS_ENABLED=true
# GATEWAY_DOCS_ENABLED=true

# --- PostgreSQL (the gateway's own database) ---------------------------------------------------
DB_URL=postgresql+asyncpg://urumi_gateway:change_me@localhost:5432/urumi_gateway
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_STATEMENT_TIMEOUT_MS=5000

# --- Authentication -----------------------------------------------------------------------------
# HMAC pepper for session tokens, API keys and invitations. >= 32 random characters, e.g.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_TOKEN_PEPPER=replace_me_with_at_least_32_random_characters
# AUTH_SESSION_TTL_HOURS=12
# AUTH_ALLOW_SIGNUP=true        # false = invitation-only registration
# AUTH_INVITATION_TTL_HOURS=72
# AUTH_PASSWORD_MIN_LENGTH=12

# --- Rate limits (per minute, shared across replicas through PostgreSQL) -------------------------
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PER_PRINCIPAL_PER_MINUTE=120
# RATE_LIMIT_MAX_TEAM_PER_MINUTE=6000
# RATE_LIMIT_AUTH_PER_MINUTE=10

# --- API keys ---------------------------------------------------------------------------------
# API_KEY_DEFAULT_TTL_DAYS=90
# API_KEY_MAX_TTL_DAYS=365          # ceiling for every team's max_key_ttl_days
# API_KEY_MAX_ROTATION_GRACE_HOURS=24
# API_KEY_MAX_KEYS_PER_USER_PER_TEAM=20

# --- Upstream MCP servers -------------------------------------------------------------------------
# Connector URLs must match one of these host:port patterns (SSRF guard). In a cluster:
#   UPSTREAM_ALLOWED_HOSTS=woocommerce-mcp.urumi.svc.cluster.local:8000
UPSTREAM_ALLOWED_HOSTS=127.0.0.1:*,localhost:*
# UPSTREAM_ALLOW_INSECURE_HTTP=true   # http:// is normal for ClusterIP / localhost upstreams
# UPSTREAM_IP_FAMILY=ipv4             # avoids the macOS IPv6 mDNS stall for *.local names
# UPSTREAM_CONNECT_TIMEOUT_SECONDS=3
# UPSTREAM_DEFAULT_CALL_TIMEOUT_SECONDS=30
# UPSTREAM_MAX_CALL_TIMEOUT_SECONDS=120
# UPSTREAM_MAX_CONNECTIONS=100
# UPSTREAM_DEFAULT_MAX_CONCURRENCY=20   # in-flight calls per connector per replica
# UPSTREAM_QUEUE_TIMEOUT_SECONDS=2
# UPSTREAM_TOOL_CACHE_TTL_SECONDS=60
# Encrypts connector credentials (bearer tokens / API-key headers) at rest. A Secret in a cluster.
# Generate: poetry run gateway-admin generate-credential-key. Empty disables credentials.
# UPSTREAM_CREDENTIAL_KEYS=

# --- Hosted MCP servers (deploy an MCP server from a container image) -------------------------
# Needs the gateway to run in the cluster with the chart's ServiceAccount and Role; leave it off
# when running the gateway on the host.
# HOSTED_ENABLED=false
# HOSTED_NAMESPACE=urumi-mcp
# HOSTED_ALLOWED_IMAGES=ghcr.io/github/github-mcp-server:*,mcp/duckduckgo:*
# HOSTED_GATEWAY_NAMESPACE=urumi
# HOSTED_GATEWAY_POD_LABEL=app.kubernetes.io/name=gateway
# HOSTED_DEFAULT_CPU_MILLICORES=250
# HOSTED_MAX_CPU_MILLICORES=1000
# HOSTED_DEFAULT_MEMORY_MIB=256
# HOSTED_MAX_MEMORY_MIB=1024
# HOSTED_MAX_SERVERS=10

# --- OAuth for MCP clients (MCP authorization spec) -----------------------------------------------
# The gateway becomes the OAuth authorization server for /v1/mcp: clients such as Claude Code
# register themselves, the user approves them on the dashboard, and they get short-lived keys.
# OAUTH_ENABLED=false
# OAUTH_ISSUER_URL=http://localhost:8100            # the gateway's public origin; HTTPS in production
# OAUTH_CONSENT_URL=http://localhost:5173/oauth/consent
# OAUTH_ALLOW_HTTP_ISSUER=false                     # plain HTTP for a non-localhost issuer (local clusters)
# OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# OAUTH_REFRESH_TOKEN_TTL_DAYS=30
# OAUTH_REQUESTS_PER_MINUTE=30                     # per IP on /register, /authorize, /token

# --- Provisioned stores (docs/stores.md) --------------------------------------------------------
# The gateway records store requests; the provisioner (gateway-provisioner, in the cluster) does
# the work. Both read these.
# STORES_ENABLED=false
# STORES_MAX_PER_USER=2
# STORES_MAX_TOTAL=5
# STORES_PROVISION_TIMEOUT_SECONDS=900
# STORES_BASE_DOMAIN=localtest.me                 # stores get <slug>.<base domain>
# STORES_TLS=false
# The provisioner only (gateway-provisioner; see deploy/helm/urumi values for the cluster setup):
# PROVISIONER_MCP_ADMIN_DSN=postgresql://owner:...@host/urumi   # may CREATE ROLE; one role+schema per store
# PROVISIONER_WORKERS=3
# PROVISIONER_MAX_ATTEMPTS=3
# PROVISIONER_STORE_IMAGE=docker.io/urumi/store-wordpress:<tag>
# PROVISIONER_MCP_IMAGE=urumi/woocommerce-mcp:<tag>
# PROVISIONER_CHART_PATH=/opt/urumi/charts/urumi-store

# --- Retention ----------------------------------------------------------------------------------
# RETENTION_AUDIT_DAYS=365
# RETENTION_USAGE_DAYS=90
# RETENTION_SESSIONS_DAYS=7
# RETENTION_PURGE_INTERVAL_SECONDS=3600
