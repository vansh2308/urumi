# Copy to .env for local development. Never commit real credentials; in Kubernetes inject
# these from a Secret (WC_CONSUMER_KEY, WC_CONSUMER_SECRET, DB_URL) and a ConfigMap (the rest).

APP_ENV=local                 # local | staging | production
LOG_LEVEL=INFO
LOG_FORMAT=console            # json in clusters
# Display name of the store; prefixes tool descriptions with "[Store: <name>]".
# STORE_NAME=Acme

# --- WooCommerce -----------------------------------------------------------------------------
# Must equal the WordPress "home" URL: OAuth1 signatures are computed over it.
# http:// -> OAuth 1.0a query signing (needs WC_ALLOW_INSECURE_HTTP=true)
# https:// -> HTTP Basic with the consumer key/secret
WC_BASE_URL=http://wordpress.local
WC_ALLOW_INSECURE_HTTP=true
# Optional: open the connection here instead (origin only), e.g. the in-cluster Service of a
# provisioned store. Signing and the Host header still use WC_BASE_URL.
# WC_CONNECT_URL=http://store-wordpress.store-acme.svc.cluster.local
# macOS resolves *.local via mDNS and stalls ~5 s on the IPv6 lookup even when /etc/hosts maps
# the name, which exceeds the connect timeout. ipv4 skips that lookup. Leave auto in clusters.
WC_IP_FAMILY=ipv4
WC_CONSUMER_KEY=ck_replace_me
WC_CONSUMER_SECRET=cs_replace_me
# WC_OAUTH_SIGNATURE_METHOD=HMAC-SHA256
# WC_CONNECT_TIMEOUT_SECONDS=5
# WC_READ_TIMEOUT_SECONDS=20
# WC_MAX_CONNECTIONS=50
# WC_MAX_ATTEMPTS=3
# WC_MAX_PAGE_SIZE=50

# --- PostgreSQL ------------------------------------------------------------------------------
DB_URL=postgresql+asyncpg://woocommerce_mcp:change_me@localhost:5432/woocommerce_mcp
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_STATEMENT_TIMEOUT_MS=5000

# --- MCP HTTP server -------------------------------------------------------------------------
MCP_HOST=127.0.0.1            # 0.0.0.0 in a container
MCP_PORT=8000
# MCP_PATH=/mcp
# Host headers accepted (DNS-rebinding protection). In-cluster add the Service names, e.g.
# MCP_ALLOWED_HOSTS=woocommerce-mcp:*,woocommerce-mcp.urumi.svc:*,woocommerce-mcp.urumi.svc.cluster.local:*
# MCP_STATELESS_HTTP=true
# MCP_SHUTDOWN_GRACE_SECONDS=25
# MCP_READINESS_CHECKS_WOOCOMMERCE=false

# --- Operation / idempotency records ---------------------------------------------------------
# OPERATIONS_RETENTION_HOURS=72
# OPERATIONS_IN_PROGRESS_LEASE_SECONDS=120
# OPERATIONS_PURGE_INTERVAL_SECONDS=900
