# Copy to .env.local for local overrides. Nothing here is secret: the dashboard never holds
# provider keys or upstream credentials, only the signed-in user's own tokens at runtime.

# Dev server proxy targets (vite.config.ts). The browser calls /api/gateway and /api/agent on
# the dashboard's own origin, so the services need no CORS setup in development.
GATEWAY_PROXY_TARGET=http://127.0.0.1:8100
AGENT_PROXY_TARGET=http://127.0.0.1:8201

# For a static build served from another origin, point the app at the services directly and
# allow that origin with GATEWAY_CORS_ALLOWED_ORIGINS / AGENT_CORS_ALLOWED_ORIGINS.
# VITE_GATEWAY_URL=https://gateway.example.com
# VITE_AGENT_URL=https://agent.example.com
