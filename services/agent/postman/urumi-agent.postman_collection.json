    {
      "name": "5. Cleanup",
      "description": "",
      "item": [
        {
          "name": "Delete conversation",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{agentUrl}}/v1/conversations/{{conversationId}}",
              "host": [
                "{{agentUrl}}"
              ],
