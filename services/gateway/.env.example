# Copy to .env for local development. Never commit real credentials; in Kubernetes inject
# DB_URL and AUTH_TOKEN_PEPPER from a Secret and the rest from a ConfigMap.

APP_ENV=local                 # local | staging | production
LOG_LEVEL=INFO
LOG_FORMAT=console            # json in clusters

# --- HTTP server ------------------------------------------------------------------------------
GATEWAY_HOST=127.0.0.1        # 0.0.0.0 in a container
GATEWAY_PORT=8100
# GATEWAY_SHUTDOWN_GRACE_SECONDS=25
# GATEWAY_FORWARDED_ALLOW_IPS=127.0.0.1   # ingress / load balancer addresses
# GATEWAY_MAX_REQUEST_BODY_BYTES=1048576
# GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:5173
# GATEWAY_METRICS_ENABLED=true
# GATEWAY_DOCS_ENABLED=true

# --- PostgreSQL (the gateway's own database) ---------------------------------------------------
DB_URL=postgresql+asyncpg://urumi_gateway:change_me@localhost:5432/urumi_gateway
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_STATEMENT_TIMEOUT_MS=5000

# --- Authentication -----------------------------------------------------------------------------
# HMAC pepper for session tokens, API keys and invitations. >= 32 random characters, e.g.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_TOKEN_PEPPER=replace_me_with_at_least_32_random_characters
# AUTH_SESSION_TTL_HOURS=12
# AUTH_ALLOW_SIGNUP=true        # false = invitation-only registration
# AUTH_INVITATION_TTL_HOURS=72
# AUTH_PASSWORD_MIN_LENGTH=12

# --- Rate limits (per minute, shared across replicas through PostgreSQL) -------------------------
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PER_PRINCIPAL_PER_MINUTE=120
# RATE_LIMIT_MAX_TEAM_PER_MINUTE=6000
# RATE_LIMIT_AUTH_PER_MINUTE=10

# --- API keys ---------------------------------------------------------------------------------
# API_KEY_DEFAULT_TTL_DAYS=90
# API_KEY_MAX_TTL_DAYS=365          # ceiling for every team's max_key_ttl_days
# API_KEY_MAX_ROTATION_GRACE_HOURS=24
# API_KEY_MAX_KEYS_PER_USER_PER_TEAM=20

# --- Upstream MCP servers -------------------------------------------------------------------------
# Connector URLs must match one of these host:port patterns (SSRF guard). In a cluster:
#   UPSTREAM_ALLOWED_HOSTS=woocommerce-mcp.urumi.svc.cluster.local:8000
UPSTREAM_ALLOWED_HOSTS=127.0.0.1:*,localhost:*
# UPSTREAM_ALLOW_INSECURE_HTTP=true   # http:// is normal for ClusterIP / localhost upstreams
# UPSTREAM_IP_FAMILY=ipv4             # avoids the macOS IPv6 mDNS stall for *.local names
# UPSTREAM_CONNECT_TIMEOUT_SECONDS=3
# UPSTREAM_DEFAULT_CALL_TIMEOUT_SECONDS=30
# UPSTREAM_MAX_CALL_TIMEOUT_SECONDS=120
# UPSTREAM_MAX_CONNECTIONS=100
# UPSTREAM_DEFAULT_MAX_CONCURRENCY=20   # in-flight calls per connector per replica
# UPSTREAM_QUEUE_TIMEOUT_SECONDS=2
# UPSTREAM_TOOL_CACHE_TTL_SECONDS=60

# --- Retention ----------------------------------------------------------------------------------
# RETENTION_AUDIT_DAYS=365
# RETENTION_USAGE_DAYS=90
# RETENTION_SESSIONS_DAYS=7
# RETENTION_PURGE_INTERVAL_SECONDS=3600
