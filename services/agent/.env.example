# Copy to .env for local development. Never commit real credentials; in Kubernetes inject
# DB_URL and GEMINI_API_KEY from a Secret and the rest from a ConfigMap.

APP_ENV=local                 # local | staging | production
LOG_LEVEL=INFO
LOG_FORMAT=console            # json in clusters

# --- HTTP server ------------------------------------------------------------------------------
AGENT_HOST=127.0.0.1          # 0.0.0.0 in a container
AGENT_PORT=8200
# AGENT_SHUTDOWN_GRACE_SECONDS=30
# AGENT_FORWARDED_ALLOW_IPS=127.0.0.1   # ingress / load balancer addresses
# AGENT_MAX_REQUEST_BODY_BYTES=65536
# AGENT_CORS_ALLOWED_ORIGINS=http://localhost:5173
# AGENT_METRICS_ENABLED=true
# AGENT_DOCS_ENABLED=true

# --- PostgreSQL (the agent's own database) -----------------------------------------------------
DB_URL=postgresql+asyncpg://urumi_agent:change_me@localhost:5432/urumi_agent
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_STATEMENT_TIMEOUT_MS=5000

# --- Gateway (tools are discovered and invoked only through it, with the caller's API key) ----
GATEWAY_URL=http://127.0.0.1:8100
# GATEWAY_CONNECT_TIMEOUT_SECONDS=3
# GATEWAY_REQUEST_TIMEOUT_SECONDS=15
# GATEWAY_TOOL_CALL_TIMEOUT_SECONDS=60

# --- Model provider ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
# LLM_REQUEST_TIMEOUT_SECONDS=60
# LLM_MAX_OUTPUT_TOKENS=4096
# LLM_TEMPERATURE=0.2
# LLM_MAX_RETRIES=2
GEMINI_API_KEY=replace_me

# --- Run limits (per chat request) --------------------------------------------------------------
# RUN_MAX_STEPS=8                 # model responses per run
# RUN_MAX_TOOL_CALLS=12
# RUN_MAX_PARALLEL_TOOL_CALLS=5   # tool calls the model may request in one response
# RUN_TIMEOUT_SECONDS=120
# RUN_MAX_TOKENS=200000           # input + output tokens over all model calls of a run
# RUN_MAX_MESSAGE_CHARS=8000
# RUN_HISTORY_MAX_MESSAGES=40
# RUN_MAX_TOOL_RESULT_CHARS=12000
# RUN_MAX_TOOLS=64
# RUN_RATE_LIMIT_PER_MINUTE=20    # runs per user per team
# RUN_CONVERSATION_LOCK_SECONDS=300
